config global 'global'
	option enabled '1'
	option log_level '0'

# Optional VOS 5G (Qualcomm 05c6:9064) adapter.  ECM is the conservative
# default because it preserves the modem's own data session and NAT.
config vos5g 'vos5g'
	option enabled '1'
	option mode 'ecm'
	option management_url 'https://192.168.225.1'
	option username 'admin'
	option password ''
	option password_cipher ''
	option poll_interval '10'
	option apn ''
