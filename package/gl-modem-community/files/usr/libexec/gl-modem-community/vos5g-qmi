#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
#
# Select the VOS 5G QMI USB configuration on GL.iNet routers.  The modem's
# Linux default is configuration 2 (CDC ECM); configuration 1 exposes its
# upstream-supported 05c6:9064 QMI function on USB interface 3.

set -eu

SYS_USB=${SYS_USB:-/sys/bus/usb}
LOGGER_BIN=${LOGGER_BIN:-logger}
QMI_DRIVER=${QMI_DRIVER:-$SYS_USB/drivers/qmi_wwan}
OPTION_DRIVER=${OPTION_DRIVER:-$SYS_USB/drivers/option}
OPTION_NEW_ID=${OPTION_NEW_ID:-/sys/bus/usb-serial/drivers/option1/new_id}
ADB_BIN=${ADB_BIN:-adb}
TIMEOUT_BIN=${TIMEOUT_BIN:-timeout}
UQMI_BIN=${UQMI_BIN:-uqmi}
FLOCK_BIN=${FLOCK_BIN:-flock}
DEV_ROOT=${DEV_ROOT:-/dev}
LOCK_ROOT=${LOCK_ROOT:-/var/lock}
RUNTIME_DIR=${RUNTIME_DIR:-/var/run/gl-modem-community}
WAIT_LOOPS=${WAIT_LOOPS:-20}
ADB_WAIT_SECS=${ADB_WAIT_SECS:-30}
QCMAP_SERVICE=${QCMAP_SERVICE:-QCMAP_ConnectionManagerd.service}
QCMAP_SETTLE_LOOPS=${QCMAP_SETTLE_LOOPS:-20}
QMI_TIMEOUT_MS=${QMI_TIMEOUT_MS:-5000}
QMI_WALL_SECS=${QMI_WALL_SECS:-8}
QMI_RELEASE_WAIT_SECS=${QMI_RELEASE_WAIT_SECS:-2}

log() {
	"$LOGGER_BIN" -t gl-modem-community "vos5g-qmi: $*"
}

valid_bus() {
	case "$1" in
	''|*[!A-Za-z0-9._-]*) return 1 ;;
	*) return 0 ;;
	esac
}

is_vos5g() {
	device=$SYS_USB/devices/$1
	[ -r "$device/idVendor" ] &&
		[ -r "$device/idProduct" ] &&
		[ "$(cat "$device/idVendor")" = 05c6 ] &&
		[ "$(cat "$device/idProduct")" = 9064 ]
}

driver_name() {
	path=$SYS_USB/devices/$1/driver
	[ -L "$path" ] || return 0
	basename "$(readlink "$path")"
}

device_serial() {
	cat "$SYS_USB/devices/$1/serial" 2>/dev/null || true
}

device_devnum() {
	cat "$SYS_USB/devices/$1/devnum" 2>/dev/null || true
}

stamp_path() {
	printf '%s/vos5g-prepared-%s\n' "$RUNTIME_DIR" "$1"
}

# A completed preparation stays valid for the lifetime of one USB connection.
# The kernel assigns a new devnum on physical detach/attach, so a stamp that
# still matches the current devnum proves QCMAP was stopped and the WDS
# autoconnect cleared for exactly this connection.
prepare_is_current() {
	current=$(device_devnum "$1")
	[ -n "$current" ] || return 1
	recorded=$(cat "$(stamp_path "$1")" 2>/dev/null) || return 1
	[ "$recorded" = "$current" ]
}

record_prepared() {
	current=$(device_devnum "$1")
	[ -n "$current" ] || return 0
	mkdir -p "$RUNTIME_DIR"
	printf '%s\n' "$current" >"$(stamp_path "$1")"
}

adb_for_bus() {
	bus=$1
	shift
	serial=$(device_serial "$bus")
	[ -n "$serial" ] || return 1
	"$ADB_BIN" start-server >/dev/null 2>&1 || return 1
	"$TIMEOUT_BIN" "$ADB_WAIT_SECS" \
		"$ADB_BIN" -s "$serial" wait-for-device >/dev/null 2>&1 || return 1
	"$ADB_BIN" -s "$serial" "$@"
}

qcmap_state() {
	adb_for_bus "$1" shell systemctl is-active "$QCMAP_SERVICE" \
		2>/dev/null | tr -d '\r' || true
}

stop_qcmap() {
	bus=$1
	count=0
	state=

	# QCMAP starts late during a cold boot.  An early "inactive" response is
	# not proof that it will remain inactive, so observe its startup window
	# before handing the WDS service to the host.
	while [ "$count" -lt "$QCMAP_SETTLE_LOOPS" ]; do
		state=$(qcmap_state "$bus")
		[ "$state" = active ] && break
		sleep 1
		count=$((count + 1))
	done

	state=$(qcmap_state "$bus")
	if [ "$state" = active ]; then
		log "stopping VOS QCMAP before external QMI ownership"
		adb_for_bus "$bus" shell systemctl stop "$QCMAP_SERVICE" \
			>/dev/null 2>&1 || return 1
		state=$(qcmap_state "$bus")
	fi

	case "$state" in
	inactive|failed) return 0 ;;
	*)
		log "could not confirm VOS QCMAP is inactive on $bus (state=${state:-unavailable})"
		return 1
		;;
	esac
}

qmi_control_device() {
	bus=$1
	for control in "$SYS_USB/devices/$bus:1.3/usbmisc"/cdc-wdm*; do
		[ -e "$control" ] || continue
		printf '%s/%s\n' "$DEV_ROOT" "${control##*/}"
		return 0
	done
	return 1
}

disable_qmi_autoconnect() {
	bus=$1
	device=$(qmi_control_device "$bus") || return 1
	cid=$("$TIMEOUT_BIN" "$QMI_WALL_SECS" \
		"$UQMI_BIN" -t "$QMI_TIMEOUT_MS" -d "$device" \
		--get-client-id wds 2>/dev/null || true)
	case "$cid" in
	''|*[!0-9]*)
		log "could not obtain a WDS client ID on $bus"
		return 1
		;;
	esac

	# Stopping QCMAP does not necessarily clear its persistent WDS session.
	# Disable that autoconnect before GL.iNet's netifd QMI driver starts its
	# own session; otherwise the second --start-network is rejected.
	if ! "$TIMEOUT_BIN" "$QMI_WALL_SECS" \
		"$UQMI_BIN" -t "$QMI_TIMEOUT_MS" -d "$device" \
		--set-client-id "wds,$cid" --set-autoconnect disabled \
		>/dev/null 2>&1; then
		log "could not disable the previous WDS autoconnect on $bus"
		return 1
	fi
	"$TIMEOUT_BIN" "$QMI_WALL_SECS" \
		"$UQMI_BIN" -t "$QMI_TIMEOUT_MS" -d "$device" \
		--set-client-id "wds,$cid" --release-client-id wds \
		>/dev/null 2>&1 || true
	[ "$QMI_RELEASE_WAIT_SECS" -eq 0 ] || sleep "$QMI_RELEASE_WAIT_SECS"
}

wait_for_config() {
	bus=$1
	wanted=$2
	count=0
	while [ "$count" -lt "$WAIT_LOOPS" ]; do
		[ -r "$SYS_USB/devices/$bus/bConfigurationValue" ] || return 1
		[ "$(cat "$SYS_USB/devices/$bus/bConfigurationValue")" = "$wanted" ] && return 0
		sleep 1
		count=$((count + 1))
	done
	return 1
}

ensure_qmi_driver() {
	bus=$1
	interface=$bus:1.3
	driver=$(driver_name "$interface")
	case "$driver" in
	qmi_wwan) return 0 ;;
	'') ;;
	option)
		[ -w "$OPTION_DRIVER/unbind" ] || return 1
		printf '%s\n' "$interface" >"$OPTION_DRIVER/unbind" 2>/dev/null || return 1
		;;
	*)
		log "$interface is owned by $driver, not qmi_wwan"
		return 1
		;;
	esac

	[ -w "$QMI_DRIVER/bind" ] || return 1
	printf '%s\n' "$interface" >"$QMI_DRIVER/bind" 2>/dev/null || return 1
	[ "$(driver_name "$interface")" = qmi_wwan ]
}

ensure_at_driver() {
	bus=$1
	interface=$bus:1.2
	driver=$(driver_name "$interface")
	case "$driver" in
	option) ;;
	'')
		[ -w "$OPTION_NEW_ID" ] || return 1
		printf '05c6 9064\n' >"$OPTION_NEW_ID" 2>/dev/null || true
		if [ "$(driver_name "$interface")" != option ] &&
		   [ -w "$OPTION_DRIVER/bind" ]; then
			printf '%s\n' "$interface" >"$OPTION_DRIVER/bind" 2>/dev/null || true
		fi
		;;
	*)
		log "$interface is owned by $driver, not option"
		return 1
		;;
	esac

	[ "$(driver_name "$interface")" = option ] || return 1

	# The dynamic ID is necessarily device-wide.  Keep only the verified AT
	# interface attached; QMI remains on interface 3.
	for unwanted in "$bus:1.0" "$bus:1.1"; do
		if [ "$(driver_name "$unwanted")" = option ] &&
		   [ -w "$OPTION_DRIVER/unbind" ]; then
			printf '%s\n' "$unwanted" >"$OPTION_DRIVER/unbind" 2>/dev/null || true
		fi
	done
}

prepare_one() {
	bus=$1
	valid_bus "$bus" || return 1
	is_vos5g "$bus" || return 0

	device=$SYS_USB/devices/$bus
	config=$(cat "$device/bConfigurationValue")
	if [ "$config" != 1 ]; then
		[ -w "$device/bConfigurationValue" ] || return 1
		log "switching $bus from USB configuration $config to QMI configuration 1"
		printf '1\n' >"$device/bConfigurationValue"
		wait_for_config "$bus" 1 || return 1
	fi

	ensure_qmi_driver "$bus" || {
		log "QMI interface did not bind on $bus"
		return 1
	}
	ensure_at_driver "$bus" || {
		log "AT interface did not bind on $bus"
		return 1
	}
	stop_qcmap "$bus" || {
		log "could not release VOS QCMAP ownership on $bus"
		return 1
	}
	disable_qmi_autoconnect "$bus" || {
		log "could not clear VOS QCMAP autoconnect on $bus"
		return 1
	}
}

prepare_all() {
	for device in "$SYS_USB"/devices/*; do
		[ -d "$device" ] || continue
		bus=${device##*/}
		is_vos5g "$bus" || continue
		prepare_locked "$bus"
	done
}

prepare_locked() {
	bus=$1
	valid_bus "$bus" || return 1
	is_vos5g "$bus" || return 0
	mkdir -p "$LOCK_ROOT"
	exec 9>"$LOCK_ROOT/vos5g-qmi-$bus.lock"
	# Block instead of skipping on contention.  A caller that loses the
	# race (service start versus a USB bind event) must not report success
	# until the winning prepare has actually finished, and a bind event
	# that arrives while another prepare is running must retry afterwards
	# rather than being dropped.  prepare_one is bounded, so this wait is
	# bounded too.
	"$FLOCK_BIN" 9 || return 1
	if prepare_is_current "$bus"; then
		return 0
	fi
	prepare_one "$bus" || return 1
	record_prepared "$bus"
}

command=${1:-prepare}
case "$command" in
prepare)
	if [ "$#" -ge 2 ]; then
		prepare_locked "$2"
	else
		prepare_all
	fi
	;;
*)
	echo "usage: ${0##*/} prepare [usb-bus]" >&2
	exit 2
	;;
esac
