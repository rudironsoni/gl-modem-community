-- Transparent stock modem RPC dispatcher with community-driver hooks.

local cjson = require "cjson"
local nixio_ok, nixio_fs = pcall(require, "nixio.fs")
if not nixio_ok then nixio_fs = nil end
local getenv = os and type(os.getenv) == "function" and os.getenv or nil
local gettime = os and type(os.time) == "function" and os.time or nil
local io_open = io and type(io.open) == "function" and io.open or nil
local io_popen = io and type(io.popen) == "function" and io.popen or nil
local driver_dir = (getenv and getenv("GL_MODEM_COMMUNITY_RPC_DRIVER_DIR")) or
    "/usr/share/gl-modem-community/rpc-drivers"
local sysfs_usb_root = (getenv and getenv("GL_MODEM_COMMUNITY_SYSFS_USB_ROOT")) or
    "/sys/bus/usb/devices"
local runtime_dir = (getenv and getenv("GL_MODEM_COMMUNITY_RUNTIME_DIR")) or
    "/var/run/gl-modem-community"
-- Keep values through three default 30-second watcher intervals so a single
-- best-effort QMI timeout does not make the stock UI flap back to technology.
local band_cache_max_age = tonumber(getenv and
    getenv("GL_MODEM_COMMUNITY_BAND_CACHE_MAX_AGE")) or 90
local drivers = {}

local function shell_quote(value)
    return "'" .. value:gsub("'", "'\\''") .. "'"
end

local function load_drivers()
    local paths = {}
    if nixio_fs and type(nixio_fs.dir) == "function" then
        local iterator = nixio_fs.dir(driver_dir)
        if not iterator then return end
        for name in iterator do
            if name:match("%.lua$") then
                paths[#paths + 1] = driver_dir .. "/" .. name
            end
        end
    elseif io_popen then
        -- Preserve the original loader on targets where nixio.fs is not a
        -- package dependency. Quoting also keeps the test override inert.
        local pipe = io_popen("find " .. shell_quote(driver_dir) ..
            " -type f -name '*.lua' 2>/dev/null | sort")
        if not pipe then return end
        for path in pipe:lines() do paths[#paths + 1] = path end
        pipe:close()
    else
        -- A restricted OUI worker may expose neither filesystem API. The
        -- stock RPC object must still load and pass every method through.
        return
    end
    table.sort(paths)
    for _, path in ipairs(paths) do
        local ok, driver = pcall(dofile, path)
        if ok and type(driver) == "table" and type(driver.methods) == "table" then
            drivers[#drivers + 1] = driver
        end
    end
end

local function readfile(path)
    if nixio_fs and type(nixio_fs.readfile) == "function" then
        return nixio_fs.readfile(path)
    end
    if not io_open then return nil end
    local file = io_open(path, "r")
    if not file then return nil end
    local value = file:read("*a")
    file:close()
    return value
end

local function usb_id_for_bus(bus)
    if type(bus) ~= "string" or not bus:match("^[%w%.:_-]+$") then return nil end
    local base = sysfs_usb_root .. "/" .. bus
    local vid = readfile(base .. "/idVendor")
    local pid = readfile(base .. "/idProduct")
    if not vid or not pid then return nil end
    vid = vid:match("^%s*(%x+)")
    pid = pid:match("^%s*(%x+)")
    if not vid or not pid then return nil end
    return vid:lower() .. ":" .. pid:lower()
end

local function find_fm350_bus()
    if nixio_fs and type(nixio_fs.dir) == "function" then
        local iterator = nixio_fs.dir(sysfs_usb_root)
        if not iterator then return nil end
        for bus in iterator do
            local id = usb_id_for_bus(bus)
            if id == "0e8d:7126" or id == "0e8d:7127" then return bus end
        end
        return nil
    end
    if not io_popen then return nil end
    local pipe = io_popen("ls " .. shell_quote(sysfs_usb_root) ..
        " 2>/dev/null")
    if not pipe then return nil end
    for bus in pipe:lines() do
        local id = usb_id_for_bus(bus)
        if id == "0e8d:7126" or id == "0e8d:7127" then
            pipe:close()
            return bus
        end
    end
    pipe:close()
    return nil
end

local function fresh_cache_for_bus(prefix, bus)
    if type(bus) ~= "string" or not bus:match("^[%w%.:_-]+$") then return nil end
    if not nixio_fs or type(nixio_fs.stat) ~= "function" or
        type(nixio_fs.readfile) ~= "function" or not gettime then
        return nil
    end
    local path = runtime_dir .. "/" .. prefix .. bus
    local stat = nixio_fs.stat(path)
    if type(stat) ~= "table" or type(stat.mtime) ~= "number" or
        gettime() - stat.mtime > band_cache_max_age then
        return nil
    end
    local value = nixio_fs.readfile(path)
    return value and value:match("^%s*(.-)%s*$") or nil
end

local function band_for_bus(bus)
    local value = fresh_cache_for_bus("vos5g-band-", bus)
    if not value then return nil end
    value = value:match("^%s*([nB0-9+]+)%s*$")
    if not value or value:match("^%+") or value:match("%+$") or
        value:match("%+%+") then
        return nil
    end
    return value
end

local function nr_mode_for_bus(bus)
    local value = fresh_cache_for_bus("vos5g-mode-", bus)
    if value == "SA" or value == "NSA" then return value end
    return nil
end

local function vendor_call(method, args)
    local response = ngx.location.capture("/cgi-bin/glc", {
        method = ngx.HTTP_POST,
        body = cjson.encode({ object = "modem", method = method, args = args or {} }),
    })
    if response.status ~= ngx.HTTP_OK then return -32603 end
    local code = tonumber(response.body:match("^(-?%d+)"))
    if not code then return -32603 end
    if code ~= 0 then return code end
    local payload = response.body:match("^-?%d+ (.*)$")
    if not payload or payload == "" then return cjson.null end
    local ok, decoded = pcall(cjson.decode, payload)
    return ok and decoded or -32603
end

local function apply_result_handlers(method, args, result)
    local context = {
        usb_id_for_bus = usb_id_for_bus,
        band_for_bus = band_for_bus,
        nr_mode_for_bus = nr_mode_for_bus,
        vendor_results = {},
    }
    local applicable = {}
    for _, driver in ipairs(drivers) do
        local matches = true
        if type(driver.result_matches) == "function" then
            local ok, matched = pcall(driver.result_matches,
                method, args, result, context)
            matches = ok and matched == true
        end
        applicable[driver] = matches
        local dependencies = driver.result_dependencies
        dependencies = type(dependencies) == "table" and
            dependencies[method] or nil
        if matches and type(dependencies) == "table" then
            for _, dependency in ipairs(dependencies) do
                if context.vendor_results[dependency] == nil then
                    context.vendor_results[dependency] =
                        vendor_call(dependency, {})
                end
            end
        end
    end
    for _, driver in ipairs(drivers) do
        local handlers = driver.result_methods
        local handler = type(handlers) == "table" and handlers[method] or nil
        if applicable[driver] and handler then
            local ok, transformed = pcall(handler, args, result, context)
            if ok and transformed ~= nil then result = transformed end
        end
    end
    return result
end

local function dispatch(method, args)
    args = args or {}
    if type(args.bus) ~= "string" or args.bus == "" then
        local bus = find_fm350_bus()
        if bus then args.bus = bus end
    end
    local id = usb_id_for_bus(args.bus)
    if id then
        for _, driver in ipairs(drivers) do
            if driver.usb_ids and driver.usb_ids[id] and driver.methods[method] then
                return driver.methods[method](args)
            end
        end
    end
    local result = vendor_call(method, args)
    return apply_result_handlers(method, args, result)
end

load_drivers()

local methods = {}
for _, method in ipairs({
    "set_profile", "get_sim_config", "set_sim_config", "set_connect",
    "set_sim_pin_code", "get_slot_failover_config", "set_slot_failover_config",
    "set_apn_db_update", "remove_profile", "set_cell_tower", "get_cell_tower",
    "scan_cell_tower", "set_operator_config", "scan_operator_list",
    "get_operator_config", "send_at_command", "get_slot_config",
    "set_slot_config",
    "get_traffic_config", "set_traffic_config", "disconnect", "get_debug_msg",
    "get_profile_list", "get_info", "get_status", "get_network_info"
}) do
    local name = method
    methods[name] = function(args) return dispatch(name, args or {}) end
end

return methods
