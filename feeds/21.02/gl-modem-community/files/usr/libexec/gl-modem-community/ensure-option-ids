#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
#
# Ensure the kernel's option driver claims FM350-GL vendor-specific interfaces.
#
# On kernels older than 6.6, the option module's static ID table does not
# include 0e8d:7126 / 0e8d:7127.  This script adds them at runtime via
# the option driver's new_id sysfs interface, falling back to reloading the
# usbserial module with explicit vendor/product parameters.
#
# Also switches the FM350 from MBIM/QMI mode to AT mode via AT+CUSBMODE=0.

set -eu

LOGGER_BIN=${LOGGER_BIN:-logger}
SYS_USB=${SYS_USB:-/sys/bus/usb}
SYS_USB_SERIAL=${SYS_USB_SERIAL:-/sys/bus/usb-serial}
SYS_TTY=${SYS_TTY:-/sys/class/tty}
MODULES_DIR=${MODULES_DIR:-/lib/modules}
MODULE_BASE=${MODULE_BASE:-$(uname -r)}

FM350_VID=0e8d
FM350_PIDS="7126 7127"

log() {
	"$LOGGER_BIN" -t gl-modem-community "ensure-option-ids: $*"
}

# Return 0 if any FM350 interface already has a driver bound.
option_already_bound() {
	local device
	for device in "$SYS_USB"/devices/*; do
		[ -r "$device/idVendor" ] || continue
		[ "$(cat "$device/idVendor")" = "$FM350_VID" ] || continue
		case "$(cat "$device/idProduct" 2>/dev/null)" in
			7126|7127) ;;
			*) continue ;;
		esac
		local iface
		for iface in "$device"/*/; do
			[ -r "${iface}bInterfaceClass" ] || continue
			[ "$(cat "${iface}bInterfaceClass")" = ff ] || continue
			if [ -L "${iface}driver" ]; then
				case "$(basename "$(readlink "${iface}driver")")" in
					option) return 0 ;;
				esac
			fi
		done
	done
	return 1
}

# Try writing to the option driver's new_id sysfs file.
try_new_id() {
	local vid=$1 pid=$2 path
	for path in \
		"$SYS_USB_SERIAL/drivers/option1/new_id" \
		"$SYS_USB/drivers/option/new_id"; do
		if [ -w "$path" ]; then
			printf '%s %s\n' "$vid" "$pid" >"$path" 2>/dev/null && return 0
		fi
	done
	return 1
}

# Reload usbserial with explicit vendor/product parameters.
try_module_reload() {
	local mod_path="$MODULES_DIR/$MODULE_BASE/usbserial.ko"
	[ -f "$mod_path" ] || return 1

	rmmod option 2>/dev/null || true
	rmmod usbserial 2>/dev/null || true
	insmod "$mod_path" vendor=0x$FM350_VID product=0x7126,0x7127 2>/dev/null \
		&& return 0
	return 1
}

# Find the AT command port for a given FM350 bus and product ID.
# Returns the tty device path (e.g., /dev/ttyUSB3) or empty.
find_at_port() {
	local bus=$1 pid=$2
	local expected_iface
	case "$pid" in
		7126) expected_iface="1.4" ;;  # port_offset_at=2 -> interface 1.4 (1.2 + 2)
		7127) expected_iface="1.5" ;;  # port_offset_at=3 -> interface 1.5 (1.2 + 3)
		*) return 1 ;;
	esac

	local path real_port
	for path in "$SYS_TTY"/ttyUSB*/device; do
		[ -e "$path" ] || continue
		real=$(readlink -f "$path" 2>/dev/null) || continue
		case "$real" in
			"$SYS_USB/devices/$bus/"*"$expected_iface"*)
				echo "/dev/${path#"$SYS_TTY"/}"
				return 0
				;;
		esac
	done
	return 1
}

# Wait for FM350 to fully enumerate (all option interfaces present).
# Returns 0 when ready, 1 on timeout.
wait_for_enumeration() {
	local bus=$1 pid=$2
	local timeout=30
	local elapsed=0
	local expected_ifaces=8  # 8 option interfaces for FM350

	log "waiting for FM350 $bus:$pid to fully enumerate..."

	while [ "$elapsed" -lt "$timeout" ]; do
		local count=0
		local path
		for path in "$SYS_TTY"/ttyUSB*/device; do
			[ -e "$path" ] || continue
			real=$(readlink -f "$path" 2>/dev/null) || continue
			case "$real" in
				"$SYS_USB/devices/$bus/"*"1."[2-9]*)
					count=$((count + 1))
					;;
			esac
		done

		if [ "$count" -ge "$expected_ifaces" ]; then
			log "FM350 $bus:$pid enumerated with $count option interfaces"
			return 0
		fi

		sleep 1
		elapsed=$((elapsed + 1))
	done

	log "timeout waiting for FM350 $bus:$pid enumeration (found $count/$expected_ifaces interfaces)"
	return 1
}

# Send AT+CUSBMODE=0 to switch FM350 from MBIM/QMI to AT mode.
# Returns 0 on success, 1 on failure.
switch_to_at_mode() {
	local bus=$1 pid=$2
	local port

	port=$(find_at_port "$bus" "$pid") || {
		log "cannot find AT port for $bus:$pid"
		return 1
	}

	log "switching $bus:$pid to AT mode via $port"

	# Use comgt/gcom if available (same method as fm350-at)
	if command -v comgt >/dev/null 2>&1 && [ -f /etc/gcom/fm350-at.gcom ]; then
		export AT_COMMAND="AT+CUSBMODE=0"
		comgt -d "$port" -s /etc/gcom/fm350-at.gcom 2>/dev/null || {
			log "comgt mode switch failed for $bus:$pid"
			return 1
		}
	elif [ -c "$port" ]; then
		stty -F "$port" 115200 raw -echo 2>/dev/null || true
		printf 'AT+CUSBMODE=0\r' >"$port" 2>/dev/null
		sleep 1
		dd if="$port" of=/dev/null bs=1 count=64 timeout=2 2>/dev/null || true
	else
		log "AT port $port not accessible"
		return 1
	fi

	# Wait for USB re-enumeration (mode switch causes disconnect/reconnect)
	sleep 3
	return 0
}

main() {
	if option_already_bound; then
		log "FM350 already claimed by option driver"
		return 0
	fi

	log "FM350 not claimed by option; attempting ID injection"

	local added=0 pid
	for pid in $FM350_PIDS; do
		if try_new_id "$FM350_VID" "$pid"; then
			log "added $FM350_VID:$pid via new_id"
			added=1
		fi
	done

	if [ "$added" -eq 0 ]; then
		log "new_id failed; trying usbserial module reload"
		if try_module_reload; then
			log "usbserial reloaded with FM350 IDs"
			added=1
		else
			log "usbserial reload failed"
		fi
	fi

	if [ "$added" -eq 0 ]; then
		log "all ID injection methods failed; option driver cannot claim FM350"
		return 1
	fi

	# Give the kernel a moment to enumerate ttyUSB nodes.
	sleep 2

	# Wait for FM350 to fully enumerate before attempting mode switch
	local device bus pid
	for device in "$SYS_USB"/devices/*; do
		[ -r "$device/idVendor" ] || continue
		[ "$(cat "$device/idVendor")" = "$FM350_VID" ] || continue
		pid=$(cat "$device/idProduct" 2>/dev/null || true)
		case "$pid" in 7126|7127) ;; *) continue ;; esac
		bus=${device##*/}
		wait_for_enumeration "$bus" "$pid" || continue
		switch_to_at_mode "$bus" "$pid" || log "mode switch failed for $bus:$pid (may already be in AT mode)"
	done

	# Wait for re-enumeration after mode switch
	sleep 3

	if option_already_bound; then
		log "FM350 now claimed by option driver"
	else
		log "ID injection completed but FM350 still not claimed by option"
		return 1
	fi
}

main "$@"